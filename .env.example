# learn — LOCAL development env (`pnpm dev`). Copy to .env.local.
# Deployed instances use .env.dev.example / .env.prod.example instead — see
# docs/ENVIRONMENTS.md for every variable (what it does, dev vs prod values).
# Placeholders only: never put real secrets or key material in this file.

# --- Runtime ---
PORT=3000
NODE_ENV=development
# Injected by Next.js (never set by hand): instrumentation.ts only bootstraps
# the signing key when it is `nodejs`.
# NEXT_RUNTIME=
# Public URL of this app (host = the `aud` of scoped app tokens).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mount path behind the reverse proxy. Deployed: /learn (Caddy forwards it
# intact). Leave empty locally to serve at /.
NEXT_PUBLIC_BASE_PATH=

# --- This app's own database ---
# drizzle-orm + postgres (postgres.js), this app's own Postgres schema only.
# Never a kernel database or another app's schema — see docs/MIGRATIONS.md.
DATABASE_URL=postgres://user:CHANGE_ME@localhost:5432/imajin_dev
# The Postgres schema this app owns exclusively. Never change it.
APP_DB_SCHEMA=learn

# --- Imajin kernel (the public app surface this app composes; AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# Same value, exposed to the browser — builds the "Sign in with Imajin" redirect.
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# The kernel's own base URL — used by loadAppSigningKey() at boot and as the
# PAY_SERVICE_URL fallback.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# Kernel service base URLs, each INCLUDING its prefix. No secrets.
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
REGISTRY_SERVICE_URL=https://dev-jin.imajin.ai/registry
# Called WITHOUT any credential: learn holds no service-scope secret.
PROFILE_SERVICE_URL=https://dev-jin.imajin.ai/profile
# Optional: defaults to $IMAJIN_KERNEL_URL/pay.
PAY_SERVICE_URL=https://dev-jin.imajin.ai/pay
# Links to other Imajin apps (pay Connect check, events banner):
# prod: https://   dev: https://dev-
NEXT_PUBLIC_SERVICE_PREFIX=https://dev-
NEXT_PUBLIC_DOMAIN=imajin.ai
# Selects the kernel session cookie (imajin_session_dev). Must be `dev` on
# every dev instance; leave unset on prod.
IMAJIN_ENV=dev

# --- This app's registration credentials (docs/REGISTRATION.md) ---
# instrumentation.ts refuses to start without IMAJIN_APP_DID.
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# Public registry id (app_...), returned by registration — safe to expose.
NEXT_PUBLIC_IMAJIN_APP_ID=app_REPLACE_ME

# --- This app's own signing key (@ima-jin/auth-client loadAppSigningKey()) ---
# NEVER put a raw private key in this file: instrumentation.ts fails loud at
# boot if IMAJIN_APP_PRIVATE_KEY is set, so it is intentionally not listed
# below as a value (docs/ENVIRONMENTS.md, "Forbidden").
# IMAJIN_APP_PRIVATE_KEY=
# One-time claim code from the operator's /jin approval card. Needed ONLY on
# first boot (no keystore yet); delete it once the app has booted once.
# IMAJIN_APP_CLAIM_CODE=
# Where the local 0600 bootstrap keypair is persisted (never the signing key).
# Defaults to ./.imajin/keystore.json. Deployed: a per-environment path that
# survives deploys.
# IMAJIN_APP_KEYSTORE=

# --- Session (signed by @ima-jin/auth-client, HS256) ---
# 32+ random bytes, e.g.: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# --- Logging (stdout only; pm2 captures it) ---
# LOG_LEVEL=info
# Leave these unset: this app never persists logs anywhere (AGENTS.md).
# ENABLE_REQUEST_LOG=
# ENABLE_APP_LOG=
# LOG_DB_TRANSPORT=
# APP_LOG_LEVEL=

# --- Read by @ima-jin/* dependencies on paths learn does not use ---
# Leave unset. Listed so this file covers every variable the code can read.
# ATTESTATION_INTERNAL_API_KEY=
# AUTH_INTERNAL_API_KEY=
# PROFILE_INTERNAL_API_KEY=
# NODE_DID=
# APP_URL=
# NEXT_PUBLIC_BASE_URL=
# REGISTRY_URL=
# SESSION_COOKIE_SCOPE=
# NEXT_PUBLIC_BUILD_HASH=
# NEXT_PUBLIC_COMMIT_COUNT=
# NEXT_PUBLIC_VERSION=
# NEXT_PUBLIC_NOTIFY_URL=

# --- Tests / CI only ---
# A throwaway Postgres server for the migration CLI tests (scratch databases).
# MIGRATIONS_TEST_DATABASE_URL=
